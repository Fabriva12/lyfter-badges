# Connection used by the app at runtime (Supabase session pooler).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=no-verify"

# Connection used by the Prisma CLI for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=no-verify"

# Shadow database for `prisma migrate dev`.
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lyfter_shadow?sslmode=no-verify"

# Better Auth secret (generate a long random value).
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Public base URL of the app.
BETTER_AUTH_URL="http://localhost:3000"

# Seed demo events, badges, QR tokens and test users.
# Set to "true" only when running `pnpm prisma db seed` locally.
SEED_DEMO_DATA="false"
